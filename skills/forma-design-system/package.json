{
  "name": "@kurotch-homelab/forma-design-system-skill",
  "version": "2.0.0",
  "description": "GitHub PackagesからFormaを導入するスキル。React・CSS・トークンの導入支援、IBM Plex Sans JP、設計指針を提供。",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kurotch-homelab/design-system.git",
    "directory": "skills/forma-design-system"
  },
  "keywords": [
    "agent-skill",
    "forma",
    "design-system",
    "react",
    "css",
    "business-ui",
    "japanese"
  ],
  "files": [
    "SKILL.md",
    "README.md",
    "references",
    "scripts",
    "assets",
    "bundle.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "agentSkill": {
    "compatibleAgents": [
      "codex",
      "claude"
    ],
    "dataMode": "hybrid",
    "snapshot": "2026-11-07",
    "requirements": {
      "environment": [
        {
          "name": "NODE_AUTH_TOKEN",
          "description": "GitHub Packagesを読むためのread:packages権限付きpersonal access token (classic)。npm設定の環境変数から参照する。"
        }
      ],
      "commands": [
        "node",
        "npm"
      ],
      "endpoints": [
        "https://npm.pkg.github.com"
      ]
    }
  },
  "license": "(MIT AND OFL-1.1)"
}
